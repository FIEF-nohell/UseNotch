<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UseNotch.App.ViewModels"
        xmlns:controls="using:UseNotch.App.Controls"
        x:Class="UseNotch.App.Views.OverlayWindow"
        x:DataType="vm:OverlayViewModel"
        Title="UseNotch overlay"
        Width="440"
        Height="320"
        Background="Transparent"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Topmost="True"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual">
  <Grid Background="Transparent">

    <!--
      The notch. Nothing at all is drawn until the pointer reaches the screen edge, so an idle desktop
      shows no trace of this window. The bar hugs the edge and is rounded only on the inner side.
    -->
    <Border x:Name="NotchBar"
            IsVisible="{Binding ShowsProviderCells}"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Width="92"
            Background="#FF000000"
            CornerRadius="26,0,0,26"
            Padding="0,18">
      <StackPanel Spacing="16">
        <Button x:Name="OpenAiCell"
                Classes="providerItem"
                Click="OnOpenAiClicked"
                AutomationProperties.Name="{Binding OpenAi.AutomationName}">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <Panel Width="56" Height="56">
              <controls:QuotaRing Width="56" Height="56"
                                  StrokeThickness="4"
                                  Fraction="{Binding OpenAi.RingFraction}">
                <controls:QuotaRing.ArcBrush>
                  <MultiBinding Converter="{x:Static vm:SeverityConverters.ToRingBrush}">
                    <Binding Path="OpenAi.Severity" />
                    <Binding Path="OpenAi.Provider" />
                  </MultiBinding>
                </controls:QuotaRing.ArcBrush>
              </controls:QuotaRing>
              <Path Data="{x:Static vm:ProviderGlyphs.OpenAi}"
                    Fill="#FFF2F4F7"
                    Width="24" Height="24"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Panel>
            <TextBlock Text="{Binding OpenAi.PercentText}" Classes="percent" />
          </StackPanel>
        </Button>

        <Button x:Name="AnthropicCell"
                Classes="providerItem"
                Click="OnAnthropicClicked"
                AutomationProperties.Name="{Binding Anthropic.AutomationName}">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <Panel Width="56" Height="56">
              <controls:QuotaRing Width="56" Height="56"
                                  StrokeThickness="4"
                                  Fraction="{Binding Anthropic.RingFraction}">
                <controls:QuotaRing.ArcBrush>
                  <MultiBinding Converter="{x:Static vm:SeverityConverters.ToRingBrush}">
                    <Binding Path="Anthropic.Severity" />
                    <Binding Path="Anthropic.Provider" />
                  </MultiBinding>
                </controls:QuotaRing.ArcBrush>
              </controls:QuotaRing>
              <Path Data="{x:Static vm:ProviderGlyphs.Anthropic}"
                    Fill="#FFF2F4F7"
                    Width="24" Height="24"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Panel>
            <TextBlock Text="{Binding Anthropic.PercentText}" Classes="percent" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- Detail callout, pointing at the notch. -->
    <Grid x:Name="DetailPanel"
          IsVisible="{Binding ShowsDetails}"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Margin="0,0,92,0">
      <Border Background="#FF000000"
              CornerRadius="18"
              Padding="18,16"
              Width="300"
              Margin="0,0,10,0">
        <StackPanel Spacing="12" DataContext="{Binding DetailProvider}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Path Data="{Binding Provider, Converter={x:Static vm:ProviderGlyphs.ToGlyph}}"
                  Fill="#FFF2F4F7"
                  Width="18" Height="18"
                  Stretch="Uniform"
                  VerticalAlignment="Center" />
            <TextBlock x:Name="DetailTitle" Text="{Binding DetailTitle}" Classes="detailTitle" VerticalAlignment="Center" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Windows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:QuotaWindowRow">
                <StackPanel Spacing="6" Margin="0,0,0,10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Label}" Classes="windowLabel" />
                    <TextBlock Grid.Column="1" Text="{Binding ResetText}" Classes="windowReset" />
                  </Grid>
                  <Border Background="#FF23262C" CornerRadius="3" Height="6">
                    <Border HorizontalAlignment="Left"
                            CornerRadius="3"
                            Background="{Binding Severity, Converter={x:Static vm:SeverityConverters.ToArcBrush}}"
                            Width="{Binding Fraction, Converter={x:Static vm:SeverityConverters.ToBarWidth}}" />
                  </Border>
                  <TextBlock Text="{Binding UsedText}" Classes="windowUsed" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock x:Name="DetailText" Text="{Binding FreshnessText}" Classes="detailFooter" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ActivityText}" Classes="detailFooter" TextWrapping="Wrap" />
          <Button x:Name="CloseDetail"
                  Classes="detailClose"
                  Content="Close"
                  Click="OnCloseDetailClicked"
                  AutomationProperties.Name="Close provider details" />
        </StackPanel>
      </Border>

      <!-- The tail that ties the callout to the notch. -->
      <Path Data="M 0,0 L 10,10 L 0,20 Z"
            Fill="#FF000000"
            Width="10" Height="20"
            HorizontalAlignment="Right"
            VerticalAlignment="Center" />
    </Grid>
  </Grid>

  <Window.Styles>
    <Style Selector="Button.providerItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.providerItem:pointerover">
      <Setter Property="Background" Value="#1AFFFFFF" />
    </Style>
    <Style Selector="Button.providerItem:pressed">
      <Setter Property="Background" Value="#0DFFFFFF" />
    </Style>
    <Style Selector="Button.providerItem:focus-visible">
      <Setter Property="BorderBrush" Value="#FF8AB4FF" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBlock.percent">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#FFF2F4F7" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.detailTitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#FFF2F4F7" />
    </Style>
    <Style Selector="TextBlock.windowLabel">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#FFF2F4F7" />
    </Style>
    <Style Selector="TextBlock.windowReset">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#FFB3BBC7" />
    </Style>
    <Style Selector="TextBlock.windowUsed">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#FFB3BBC7" />
    </Style>
    <Style Selector="TextBlock.detailFooter">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#FF8A93A0" />
    </Style>
    <Style Selector="Button.detailClose">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Background" Value="#FF171B21" />
      <Setter Property="Foreground" Value="#FFD6DDE7" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.detailClose:focus-visible">
      <Setter Property="BorderBrush" Value="#FF8AB4FF" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </Window.Styles>
</Window>
