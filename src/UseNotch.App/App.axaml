<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UseNotch.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/tray-mark.ico"
                ToolTipText="UseNotch status"
                Clicked="OnTrayIconClicked">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Status and settings" Click="OnShowSettingsClicked" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Show overlay" Click="OnToggleOverlayClicked" />
            <NativeMenuItem Header="Pin overlay" IsEnabled="False" />
            <NativeMenuItem Header="Refresh usage" IsEnabled="False" />
            <NativeMenuItem Header="Pause monitoring" IsEnabled="False" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Quit" Click="OnQuitClicked" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
