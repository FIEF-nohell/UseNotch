<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\usenotch.ico</ApplicationIcon>
    <!--
      Windows shows AssemblyTitle as the file description in Explorer, Task Manager, and the Restart
      Manager prompt. Without this it would read "UseNotch.App", which is the assembly, not the product.
    -->
    <AssemblyTitle>UseNotch</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../UseNotch.Application/UseNotch.Application.csproj" />
    <ProjectReference Include="../UseNotch.Infrastructure/UseNotch.Infrastructure.csproj" />
    <ProjectReference Include="../UseNotch.Platform.Windows/UseNotch.Platform.Windows.csproj" />
    <ProjectReference Include="../UseNotch.Providers.OpenAI/UseNotch.Providers.OpenAI.csproj" />
    <ProjectReference Include="../UseNotch.Providers.Anthropic/UseNotch.Providers.Anthropic.csproj" />
  </ItemGroup>
</Project>
