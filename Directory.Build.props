<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!--
      The installer publishes self-contained for win-x64. Declaring that identifier here keeps the lock
      files consistent for both a plain restore and that publish; without it the publish rewrites every
      lock file with a runtime-specific section and a later locked restore rejects it as inconsistent.
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>8.0</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.2.0</Version>

    <!--
      One source of truth for the product's identity. These flow into the compiled assembly metadata,
      so Explorer, Task Manager, the installer, and the About section all name the product the same way
      instead of falling back to an assembly name like "UseNotch.App".
    -->
    <Product>UseNotch</Product>
    <Company>Noel Hermann</Company>
    <Authors>Noel Hermann</Authors>
    <Copyright>Copyright (c) 2026 Noel Hermann</Copyright>
    <Description>Usage overlay for OpenAI Codex and Anthropic Claude Code</Description>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
</Project>
